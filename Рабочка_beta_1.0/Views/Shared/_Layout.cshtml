<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Подработка</title>
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/font.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <div class="header-container">
            <ul class="header-container__list">
                <li class="header-container__item ">
                    <a class="header-container__text" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="/fonts/logo.svg" alt="Логотип" class="header-container__logo" />
                    </a>
                </li>
                <li class="header-container__item">
                     <a class="header-container__text" asp-area="" asp-controller="Home" asp-action="Index">Поиск работы</a>
                </li>
                <li class="header-container__item">
                    <a class="header-container__text" asp-area="" asp-controller="Profile" asp-action="Profile">Разместить вакансию</a>
                </li>
                <li class="header-container__item">
                    <a class="header-container__text" asp-area="" asp-controller="Home" asp-action="Index">О нас</a>
                </li>
            </ul>
            <div class="header-container__menu">
                @if (User?.Identity?.IsAuthenticated == true)
                { 
                    <div class="header-container__menu-profile" onclick="toggleMenu()"> 
                        <span class="header-container__menu-profile-name">@User.Identity.Name</span>
                        <img class="header-container__menu-profile-avatar" src="~/fonts/avatar.png"/>
                    </div>

                    <div class="header-container__menu-dropdown" id="dropdownMenu"> 
                        <a asp-controller="Profile" asp-action="Profile">Мой профиль</a>
                        <a href="#">Настройки</a>
                         <!-- Форма для выхода -->
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" asp-controller="Auth" asp-action="Logout">Выйти</button>
                        </form>
                    </div>
                }
                else
                {
                    <a class="job-button-login" asp-controller="Auth" asp-action="Login">
                        Войти
                    </a>
                }
            </div>
        </div>
    </header>
    <main role="main" class="main-content">
        <div class="container-body">
            @RenderBody()
        </div>
    </main>
    
    <footer>
        <div class="container-footer">
            <div class="container-footer__info">
                <div class="container-footer__info-card-p1">
                    <a class="container-footer__logo-text" asp-controller="Home" asp-action="Index">
                        <img src="/fonts/logo.svg" alt="Логотип" class="container-footer__logo" />
                    </a>
                    <p class="container-footer__info-card-text-company">
                        Рабочка - современный сервис для поиска подработки в твоём городе.
                        Найти подработку стало действительно проще, все обьявления в одном месте.
                    </p>
                </div>
                <div class="container-footer__info-card-p2">
                    <p class="container-footer__info-card-header-text">Навигация</p>
                    <ul class="container-footer__info-card-ul">
                        <li class="container-footer__info-card-item">
                            <a class="container-footer__info-card-text" asp-controller="Home" asp-action="Index">Поиск работы</a>
                        </li>
                        <li class="container-footer__info-card-item">
                            <a class="container-footer__info-card-text" asp-controller="Profile" asp-action="Profile">Разместить вакансию</a>
                        </li>
                        <li class="container-footer__info-card-item">
                            <a class="container-footer__info-card-text" asp-controller="Home" asp-action="Index">О нас</a>
                        </li>
                    </ul>

                </div>
                <div class="container-footer__info-card-p3">
                    <p class="container-footer__info-card-header-text">Правовая информация</p>
                    <ul class="container-footer__info-card-ul-pravo">
                        <li class="container-footer__info-card-ul-pravo-item">
                            <a class="container-footer__info-card-ul-pravo-text" >Политика конфиденциальности</a>
                        </li>
                        <li class="container-footer__info-card-ul-pravo-item">
                            <a class="container-footer__info-card-ul-pravo-text">Пользовательское соглашение</a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="container-footer__bottom">
                <span class="container-footer__bottom-copy">&copy; 2026 Все права защищены</span>
                <a href="https://t.me/ilapdev" class="container-footer__bottom-link">Разработано ilapdev </a>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

 <script>
    function toggleMenu() {
        const menu = document.getElementById("dropdownMenu");
        menu.style.display = menu.style.display === "flex" ? "none" : "flex";
    }

    document.addEventListener("click", function(e) {
        const menu = document.getElementById("dropdownMenu");
        const trigger = document.querySelector(".header-container__menu-profile");
        if (!trigger || !menu) return;
        if (!trigger.contains(e.target)) {
            menu.style.display = "none";
        }
    });
</script>
